<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/pure_white"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:strokeColor="#F1F5F9"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Doctor Avatar Placeholder -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAvatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardBackgroundColor="@color/input_gray"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivFotoMedico"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@color/primary_navy"
                tools:ignore="ContentDescription" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Doctor Info -->
        <TextView
            android:id="@+id/tvNomeMedico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Dr. Nome do Médico"
            android:textColor="@color/primary_navy"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/cardAvatar"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvEspecialidadeMedico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Cardiologia"
            android:textColor="@color/accent_blue"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/tvNomeMedico"
            app:layout_constraintTop_toBottomOf="@id/tvNomeMedico" />

        <TextView
            android:id="@+id/tvCrmMedico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="CRM: 123456"
            android:textColor="@color/hint_gray"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tvNomeMedico"
            app:layout_constraintTop_toBottomOf="@id/tvEspecialidadeMedico" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>