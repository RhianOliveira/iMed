<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_navy"
    tools:context=".DetalhesMedicosActivity">

    <!-- Top Navigation -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVoltarDetalhes"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:icon="?attr/homeAsUpIndicator"
        app:iconTint="@color/pure_white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDoctorDetailsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:text="@string/doctor_details_title"
        android:textColor="@color/pure_white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnVoltarDetalhes" />

    <TextView
        android:id="@+id/tvDoctorDetailsSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:text="@string/doctor_details_subtitle"
        android:textColor="#B0BEC5"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDoctorDetailsTitle" />

    <!-- Curved Content Area -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/doctorDetailsContentCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="@color/pure_white"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDoctorDetailsSubtitle"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.IMed.LoginCard">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="32dp"
                android:paddingTop="48dp"
                android:paddingBottom="40dp">

                <!-- Profile Info Header -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProfileHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/input_gray"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            app:cardBackgroundColor="@color/pure_white"
                            app:cardCornerRadius="40dp"
                            app:cardElevation="0dp">
                            <ImageView
                                android:id="@+id/ivFotoDetalhe"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/ic_menu_myplaces"
                                app:tint="@color/primary_navy"
                                tools:ignore="ContentDescription" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvNomeDetalhe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:text="Nome do Médico"
                            android:textColor="@color/primary_navy"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEspDetalhe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Especialidade"
                            android:textColor="@color/accent_blue"
                            android:textSize="16sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SECTION: DADOS PROFISSIONAIS -->
                <TextView
                    android:id="@+id/tvSectionProfessional"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/doctor_professional_section"
                    android:textColor="@color/primary_navy"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardProfileHeader" />

                <!-- CRM Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutCrm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:layout_constraintTop_toBottomOf="@id/tvSectionProfessional">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tvCrmDetalhe"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_input_new"
                        android:enabled="false"
                        android:hint="@string/hint_crm"
                        android:paddingHorizontal="20dp"
                        android:textColor="@color/pure_black"
                        android:textColorHint="@color/hint_gray" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Phone Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutTel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:layout_constraintTop_toBottomOf="@id/layoutCrm">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tvTelDetalhe"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_input_new"
                        android:enabled="false"
                        android:hint="@string/hint_phone"
                        android:paddingHorizontal="20dp"
                        android:textColor="@color/pure_black"
                        android:textColorHint="@color/hint_gray" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- SECTION: DADOS PESSOAIS -->
                <TextView
                    android:id="@+id/tvSectionPersonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/doctor_personal_section"
                    android:textColor="@color/primary_navy"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/layoutTel" />

                <!-- CPF Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutCpf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:layout_constraintTop_toBottomOf="@id/tvSectionPersonal">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tvCpfDetalhe"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_input_new"
                        android:enabled="false"
                        android:hint="@string/hint_cpf"
                        android:paddingHorizontal="20dp"
                        android:textColor="@color/pure_black"
                        android:textColorHint="@color/hint_gray" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Birthdate Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutNasc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:layout_constraintTop_toBottomOf="@id/layoutCpf">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tvDataNascDetalhe"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_input_new"
                        android:enabled="false"
                        android:hint="@string/hint_birthdate"
                        android:paddingHorizontal="20dp"
                        android:textColor="@color/pure_black"
                        android:textColorHint="@color/hint_gray" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Action Buttons -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditar"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="48dp"
                    android:text="@string/btn_edit"
                    android:textAllCaps="false"
                    android:textColor="@color/pure_white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary_navy"
                    app:cornerRadius="16dp"
                    app:layout_constraintTop_toBottomOf="@id/layoutNasc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInativar"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/btn_deactivate"
                    android:textAllCaps="false"
                    android:textColor="#B71C1C"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/btnEditar" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>