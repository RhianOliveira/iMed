<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/pure_white"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:strokeColor="#F1F5F9"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardBackgroundColor="@color/input_gray"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivFotoMedicoHist"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:padding="14dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="@color/primary_navy"
                tools:ignore="ContentDescription" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvNomeMedicoHist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Dr. Nome do Médico"
            android:textColor="@color/primary_navy"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/cardIcon"
            app:layout_constraintTop_toTopOf="@id/cardIcon" />

        <TextView
            android:id="@+id/tvDataHoraHist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Data: 00/00/0000 - 00:00"
            android:textColor="@color/hint_gray"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/tvNomeMedicoHist"
            app:layout_constraintTop_toBottomOf="@id/tvNomeMedicoHist" />

        <TextView
            android:id="@+id/tvStatusHist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_new"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="STATUS: PENDENTE"
            android:textColor="#2E7D32"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvNomeMedicoHist"
            app:layout_constraintTop_toBottomOf="@id/tvDataHoraHist" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>