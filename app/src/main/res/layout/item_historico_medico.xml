<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/pure_white"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:strokeColor="#F1F5F9"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPatientIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardBackgroundColor="@color/input_gray"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivPatientPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@color/primary_navy"
                tools:ignore="ContentDescription" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvDataAtendimento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="00/00/0000 00:00"
            android:textColor="@color/primary_navy"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardPatientIcon"
            app:layout_constraintTop_toTopOf="@id/cardPatientIcon" />

        <TextView
            android:id="@+id/tvNomePacienteAtendido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nome do Paciente"
            android:textColor="@color/accent_blue"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvDataAtendimento"
            app:layout_constraintTop_toBottomOf="@id/tvDataAtendimento" />

        <TextView
            android:id="@+id/tvResumoAtendimento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_new"
            android:padding="12dp"
            android:text="Resumo: Toque para ver o prontuário completo"
            android:textColor="@color/hint_gray"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardPatientIcon" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerProntuarioMedico"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:text="@string/btn_view_record"
            android:textAllCaps="false"
            android:textColor="@color/primary_navy"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:layout_constraintTop_toBottomOf="@id/tvResumoAtendimento" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>